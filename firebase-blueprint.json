{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique identifier for the user." },
        "displayName": { "type": "string", "description": "The user's display name." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "phoneNumber": { "type": "string", "description": "The user's phone number." },
        "role": { "type": "string", "enum": ["user"], "description": "The user's role." },
        "walletBalance": { "type": "number", "description": "The user's current wallet balance." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user was created." }
      },
      "required": ["uid", "email", "role"]
    },
    "Investment": {
      "title": "Investment",
      "description": "Investment details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID of the investor." },
        "plan": { "type": "string", "description": "The chosen investment plan." },
        "slots": { "type": "number", "description": "Number of slots invested." },
        "amount": { "type": "number", "description": "Total amount invested." },
        "status": { "type": "string", "enum": ["pending", "active", "completed"], "description": "The status of the investment." },
        "paymentId": { "type": "string", "description": "The ID of the payment record." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the investment was made." }
      },
      "required": ["uid", "plan", "slots", "amount", "status", "paymentId"]
    },
    "CooperativeMember": {
      "title": "CooperativeMember",
      "description": "Cooperative membership details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID of the member." },
        "status": { "type": "string", "enum": ["pending", "active", "inactive"], "description": "The status of the membership." },
        "registrationFeePaid": { "type": "boolean", "description": "Whether the registration fee has been paid." },
        "paymentId": { "type": "string", "description": "The ID of the payment record." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the member joined." }
      },
      "required": ["uid", "status", "registrationFeePaid", "paymentId"]
    },
    "RiceOrder": {
      "title": "RiceOrder",
      "description": "Rice purchase details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID of the buyer." },
        "items": { "type": "array", "items": { "type": "object" }, "description": "The items purchased." },
        "totalAmount": { "type": "number", "description": "Total amount paid." },
        "paymentId": { "type": "string", "description": "The ID of the payment record." },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered"], "description": "The status of the order." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the order was placed." }
      },
      "required": ["uid", "items", "totalAmount", "paymentId", "status"]
    },
    "Training": {
      "title": "Training",
      "description": "Training program details.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique identifier for the training." },
        "title": { "type": "string", "description": "The title of the training." },
        "description": { "type": "string", "description": "The description of the training." },
        "price": { "type": "number", "description": "The price of the training." },
        "date": { "type": "string", "format": "date-time", "description": "When the training will take place." },
        "isActive": { "type": "boolean", "description": "Whether the training is active." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the training was created." }
      },
      "required": ["id", "title", "price", "date", "isActive"]
    },
    "TrainingRegistration": {
      "title": "TrainingRegistration",
      "description": "Registration for a training program.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID of the registrant." },
        "trainingId": { "type": "string", "description": "The ID of the training." },
        "paymentId": { "type": "string", "description": "The ID of the payment record." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the registration was made." }
      },
      "required": ["uid", "trainingId", "paymentId"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment records.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique identifier for the payment." },
        "uid": { "type": "string", "description": "The user ID of the payer." },
        "amount": { "type": "number", "description": "The amount paid." },
        "purpose": { "type": "string", "description": "The purpose of the payment (e.g., investment, cooperative, rice, training)." },
        "status": { "type": "string", "enum": ["pending", "success", "failed"], "description": "The status of the payment." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the payment was made." }
      },
      "required": ["id", "uid", "amount", "purpose", "status"]
    },
    "ContractSubmission": {
      "title": "ContractSubmission",
      "description": "Fillable SBH Rice Farming Investment Contract Form submission.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID of the investor." },
        "name": { "type": "string", "maxLength": 150, "description": "Investor full name." },
        "phoneNo": { "type": "string", "maxLength": 40, "description": "Investor phone number." },
        "email": { "type": "string", "maxLength": 150, "description": "Investor email address." },
        "hectaresInvested": { "type": "string", "maxLength": 40, "description": "Number of hectares invested." },
        "totalAmountPaid": { "type": "string", "maxLength": 60, "description": "Total amount paid." },
        "bankName": { "type": "string", "maxLength": 120, "description": "Investor bank name." },
        "acctName": { "type": "string", "maxLength": 150, "description": "Investor bank account name." },
        "acctNo": { "type": "string", "maxLength": 40, "description": "Investor bank account number." },
        "investorSign": { "type": "string", "maxLength": 150, "description": "Investor typed signature." },
        "selectedSlot": { "type": "string", "enum": ["Bronze", "Silver", "Gold", ""], "description": "Selected slot package." },
        "status": { "type": "string", "enum": ["submitted"], "description": "Submission status." },
        "submittedAt": { "type": "string", "format": "date-time", "description": "Submission timestamp." }
      },
      "required": ["uid", "name", "phoneNo", "email", "hectaresInvested", "totalAmountPaid", "bankName", "acctName", "acctNo", "investorSign", "status"]
    },
    "KycSubmission": {
      "title": "KycSubmission",
      "description": "Fillable SBH KYC Form submission.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID of the investor." },
        "fullName": { "type": "string", "maxLength": 150, "description": "Applicant full name." },
        "email": { "type": "string", "maxLength": 150, "description": "Applicant email." },
        "phoneNumber": { "type": "string", "maxLength": 40, "description": "Applicant phone number." },
        "status": { "type": "string", "enum": ["submitted"], "description": "Submission status." },
        "submittedAt": { "type": "string", "format": "date-time", "description": "Submission timestamp." }
      },
      "required": ["uid", "fullName", "email", "phoneNumber", "status"]
    },
    "AgreementSubmission": {
      "title": "AgreementSubmission",
      "description": "Fillable 6-page SBH Joint-Venture Farming Agreement submission.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID of the partner." },
        "effectiveDay": { "type": "string", "maxLength": 40, "description": "Agreement effective day." },
        "effectiveMonthYear": { "type": "string", "maxLength": 80, "description": "Agreement effective month and year." },
        "partnerName": { "type": "string", "maxLength": 150, "description": "Partner full name." },
        "partnerAddress": { "type": "string", "maxLength": 300, "description": "Partner address." },
        "fundingPackage": { "type": "string", "maxLength": 120, "description": "Selected funding package." },
        "numberOfSlots": { "type": "string", "maxLength": 40, "description": "Number of slots subscribed." },
        "amountPaid": { "type": "string", "maxLength": 80, "description": "Amount paid." },
        "noticeAddress": { "type": "string", "maxLength": 300, "description": "Address for legal notices." },
        "partnerSignName": { "type": "string", "maxLength": 150, "description": "Partner printed name on signature block." },
        "partnerSignature": { "type": "string", "maxLength": 150, "description": "Partner typed signature." },
        "partnerSignDate": { "type": "string", "maxLength": 50, "description": "Partner signature date." },
        "nokSignature": { "type": "string", "maxLength": 150, "description": "Next of Kin typed signature." },
        "nokName": { "type": "string", "maxLength": 150, "description": "Next of Kin name." },
        "nokRelationship": { "type": "string", "maxLength": 80, "description": "Next of Kin relationship." },
        "status": { "type": "string", "enum": ["submitted"], "description": "Submission status." },
        "submittedAt": { "type": "string", "format": "date-time", "description": "Submission timestamp." }
      },
      "required": ["uid", "partnerName", "partnerAddress", "fundingPackage", "numberOfSlots", "amountPaid", "noticeAddress", "partnerSignName", "partnerSignature", "nokName", "status"]
    },
    "CertificateSubmission": {
      "title": "CertificateSubmission",
      "description": "Fillable SBH Certificate of Investment submission.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID of the investor." },
        "irCode": { "type": "string", "maxLength": 60, "description": "Investor reference IR Code." },
        "investorName": { "type": "string", "maxLength": 150, "description": "Certified investor full name." },
        "periodMonths": { "type": "string", "maxLength": 40, "description": "Investment duration in months." },
        "tenureOfInvestment": { "type": "string", "maxLength": 80, "description": "Tenure of investment." },
        "areaOfInvestment": { "type": "string", "maxLength": 120, "description": "Area of investment." },
        "amountInvested": { "type": "string", "maxLength": 80, "description": "Amount invested." },
        "subscriptionDate": { "type": "string", "maxLength": 50, "description": "Subscription date." },
        "paymentDate": { "type": "string", "maxLength": 50, "description": "Payment date." },
        "status": { "type": "string", "enum": ["submitted"], "description": "Submission status." },
        "submittedAt": { "type": "string", "format": "date-time", "description": "Submission timestamp." }
      },
      "required": ["uid", "investorName", "periodMonths", "tenureOfInvestment", "areaOfInvestment", "amountInvested", "subscriptionDate", "paymentDate", "status", "submittedAt"]
    }
  },
  "firestore": {
    "/users/{uid}": { "schema": "User", "description": "User profiles." },
    "/investments/{investmentId}": { "schema": "Investment", "description": "Investment records." },
    "/cooperativeMembers/{memberId}": { "schema": "CooperativeMember", "description": "Cooperative membership records." },
    "/riceOrders/{orderId}": { "schema": "RiceOrder", "description": "Rice purchase records." },
    "/trainings/{trainingId}": { "schema": "Training", "description": "Training programs." },
    "/trainingRegistrations/{registrationId}": { "schema": "TrainingRegistration", "description": "Training registrations." },
    "/payments/{paymentId}": { "schema": "Payment", "description": "Payment records." },
    "/contractSubmissions/{submissionId}": { "schema": "ContractSubmission", "description": "Submitted SBH Investment Contract Forms." },
    "/kycSubmissions/{submissionId}": { "schema": "KycSubmission", "description": "Submitted SBH KYC Forms." },
    "/agreementSubmissions/{submissionId}": { "schema": "AgreementSubmission", "description": "Submitted 6-Page SBH Joint-Venture Farming Agreements." },
    "/certificateSubmissions/{submissionId}": { "schema": "CertificateSubmission", "description": "Submitted SBH Certificates of Investment." }
  }
}
